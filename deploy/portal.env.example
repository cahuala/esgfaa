# Servidor público — copie para deploy/portal.env (NUNCA o ponha no repositório) e preencha.
# Gere cada chave com:  openssl rand -hex 32   e guarde uma cópia num cofre fora do servidor.

# domínio das páginas (o mesmo serve a API em /api): o DNS tem de apontar para este servidor
DOMINIO=esgfaa.gov.ao
# endereço reservado do painel (8 a 64 letras minúsculas, algarismos ou -): https://DOMINIO/ADMIN_PATH/
ADMIN_PATH=
# palavra-passe da base de dados (só a API a usa)
BD_SENHA=

JWT_SECRET=
DADOS_CHAVE=
# primeiro administrador do painel (muda a palavra-passe na 1.ª entrada e liga a verificação em dois passos)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ligação ao sistema de pessoal (a mesma chave nos dois servidores)
INTEGRACAO_CHAVE=
# e-mail das notificações (smtps://utilizador:senha@servidor:465)
SMTP_URL=
# EMAIL_REMETENTE=Portal Académico ESG <portal@esgfaa.gov.ao>
# serviços fora de Angola (IA, pesquisa na internet do anti-plágio): só com autorização (Lei n.º 22/11)
DADOS_FORA_DE_ANGOLA=nao
# cópias de segurança diárias (serviço «copias»): chave própria, diferente da DADOS_CHAVE — guarde-a no cofre,
# sem ela as cópias não abrem. COPIAS_EXTRA: pasta de outro disco ou servidor montada no contentor (opcional)
COPIAS_CHAVE=
# COPIAS_EXTRA=/copias-extra
