# Servidor INTERNO do sistema de pessoal (só a rede da Escola). HTTPS com a autoridade interna do Caddy:
# instale o certificado da raiz (docker compose ... cp web:/data/caddy/pki/authorities/local/root.crt .)
# nos computadores da Repartição, ou troque «tls internal» pelo certificado da Escola.
{$ENDERECO} {
	tls internal
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy pessoal:3002
}

# aparelhos de ponto (impressão digital): falam HTTP simples, só para /iclock (o resto não responde).
# Na firewall: a porta 8085 só a partir dos endereços dos aparelhos.
:8085 {
	@ponto path /iclock/*
	reverse_proxy @ponto pessoal:3002
	respond 404
}
