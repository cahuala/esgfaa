// Modelo de dados da API (PostgreSQL). Alterações: npx prisma migrate dev --name <descricao>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// notícias, artigos, eventos, cursos, pessoas e banners
model Item {
  colecao       String
  id            String
  dados         Json
  ordem         Int         @default(0)
  estado        String      @default("publicado")
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime    @default(now()) @map("atualizado_em") @db.Timestamptz(3)
  criadoPor     Int?        @map("criado_por")
  atualizadoPor Int?        @map("atualizado_por")
  autorEdicao   Utilizador? @relation("edicoes", fields: [atualizadoPor], references: [id], onDelete: SetNull)

  @@id([colecao, id])
  @@index([colecao, estado])
  @@map("itens")
}

// conteúdo editável das páginas (início, instituição, contactos, cursos)
model Pagina {
  chave         String   @id
  dados         Json
  atualizadoEm  DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)
  atualizadoPor Int?     @map("atualizado_por")

  @@map("paginas")
}

model Utilizador {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String    @unique
  senha              String
  papel              String
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoAcesso       DateTime? @map("ultimo_acesso") @db.Timestamptz(3)
  tentativasFalhadas Int       @default(0) @map("tentativas_falhadas")
  bloqueadoAte       DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  versaoToken        Int       @default(0) @map("versao_token")
  deveMudarSenha     Boolean   @default(false) @map("deve_mudar_senha")
  edicoes            Item[]    @relation("edicoes")

  @@index([papel])
  @@map("utilizadores")
}

model Papel {
  id         String   @id
  nome       String
  descricao  String   @default("")
  permissoes Json     @default("[]")
  sistema    Boolean  @default(false)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@map("papeis")
}

// registo de auditoria
model Atividade {
  id             Int      @id @default(autoincrement())
  utilizadorId   Int?     @map("utilizador_id")
  utilizadorNome String?  @map("utilizador_nome")
  acao           String
  colecao        String?
  alvoId         String?  @map("alvo_id")
  alvoTitulo     String?  @map("alvo_titulo")
  detalhes       String?
  ip             String?
  agente         String?
  data           DateTime @default(now()) @db.Timestamptz(3)

  @@index([data(sort: Desc)])
  @@index([utilizadorId])
  @@index([acao])
  @@map("atividades")
}

model Gosto {
  colecao   String
  itemId    String   @map("item_id")
  visitante String
  data      DateTime @default(now()) @db.Timestamptz(3)

  @@id([colecao, itemId, visitante])
  @@map("gostos")
}

model Comentario {
  id      Int      @id @default(autoincrement())
  colecao String
  itemId  String   @map("item_id")
  nome    String
  texto   String
  ip      String?
  data    DateTime @default(now()) @db.Timestamptz(3)

  @@index([colecao, itemId])
  @@index([data(sort: Desc)])
  @@map("comentarios")
}

model Visualizacao {
  colecao String
  itemId  String @map("item_id")
  total   Int    @default(0)

  @@id([colecao, itemId])
  @@map("visualizacoes")
}

// páginas vistas no site (sem IP nem agente completo)
model Visita {
  id          Int      @id @default(autoincrement())
  data        DateTime @default(now()) @db.Timestamptz(3)
  visitante   String
  caminho     String
  origem      String?
  dispositivo String?
  navegador   String?

  @@index([data])
  @@index([visitante])
  @@map("visitas")
}

model PublicidadeMetrica {
  bannerId   String   @map("banner_id")
  dia        DateTime @db.Date
  impressoes Int      @default(0)
  cliques    Int      @default(0)

  @@id([bannerId, dia])
  @@map("publicidade_metricas")
}

// sessões terminadas antes de expirarem
model SessaoRevogada {
  jti    String   @id
  expira DateTime @db.Timestamptz(3)

  @@index([expira])
  @@map("sessoes_revogadas")
}

// candidaturas aos cursos (formulário público por passos; avaliadas pela Secretaria Académica)
model Candidatura {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  curso         String
  nome          String
  email         String
  telefone      String
  dados         Json
  estado        String   @default("recebida")
  notas         String   @default("")
  ip            String?
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  atualizadaEm  DateTime @default(now()) @map("atualizada_em") @db.Timestamptz(3)
  atualizadaPor Int?     @map("atualizada_por")

  @@index([estado])
  @@index([curso])
  @@index([email])
  @@index([criadaEm(sort: Desc)])
  @@map("candidaturas")
}

// ======================= Portal académico =======================

// conta do portal: estudante ou docente (separada das contas do painel)
model ContaPortal {
  id                 Int       @id @default(autoincrement())
  tipo               String // "estudante" | "docente"
  numero             String    @unique // n.º de estudante ou de docente
  nome               String
  email              String    @unique
  senha              String
  ativo              Boolean   @default(true)
  dados              Json      @default("{}") // posto, ramo, telefone, …
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoAcesso       DateTime? @map("ultimo_acesso") @db.Timestamptz(3)
  tokenCalendario    String?   @unique @map("token_calendario") // assinatura do calendário (iCal), sem sessão
  tentativasFalhadas Int       @default(0) @map("tentativas_falhadas")
  bloqueadoAte       DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  versaoToken        Int       @default(0) @map("versao_token")
  deveMudarSenha     Boolean   @default(true) @map("deve_mudar_senha")
  notificarEmail     Boolean   @default(true) @map("notificar_email") // receber também por e-mail

  matriculas                  Matricula[]
  docencias                   Docencia[]
  topicos                     ForumTopico[]
  respostas                   ForumResposta[]
  conclusoes                  Conclusao[]
  tentativas                  Tentativa[]
  notificacoes                Notificacao[]
  mensagensEnviadas           Mensagem[]                  @relation("enviadas")
  mensagensRecebidas          Mensagem[]                  @relation("recebidas")
  notas                       NotaPauta[]
  entregas                    Entrega[]
  presencas                   Presenca[]
  pedidos                     Pedido[]
  perguntaBancos              PerguntaBanco[]
  certificados                Certificado[]
  inqueritosAvaliados         Inquerito[]                 @relation("avaliado")
  participacoes               ParticipacaoInquerito[]
  grupos                      MembroGrupo[]
  registos                    RegistoAcesso[]
  subscricoesTopicos          SubscricaoTopico[]
  subscricoesForuns           SubscricaoForum[]
  submissoesWorkshop          SubmissaoWorkshop[]
  avaliacoesPares             AvaliacaoPar[]
  termosGlossario             TermoGlossario[]
  versoesWiki                 VersaoWiki[]
  inscricoes                  InscricaoCadeira[]
  tfcs                        TrabalhoFimCurso[]
  diplomas                    CertificadoCurso[]
  participacoesInstitucionais ParticipacaoInstitucional[]

  @@index([tipo])
  @@map("contas_portal")
}

// turma de um curso num ano letivo (ex.: CEM 2026/2027)
model Turma {
  id            Int      @id @default(autoincrement())
  curso         String // identificador do curso (coleção "cursos")
  anoLetivo     String   @map("ano_letivo")
  anoCurricular Int      @default(1) @map("ano_curricular") // 1.º ano, 2.º ano, …
  nome          String
  ativa         Boolean  @default(true)
  anoFinal      Boolean  @default(false) @map("ano_final") // turma de finalistas (último ano: trabalho de fim de curso)
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  cadeiras   UnidadeCurricular[]
  matriculas Matricula[]
  avisos     AvisoGeral[]
  eventos    EventoAcademico[]
  tfcs       TrabalhoFimCurso[]
  diplomas   CertificadoCurso[]

  @@unique([curso, anoLetivo, nome])
  @@map("turmas")
}

// matrícula de um estudante numa turma (feita pela Secretaria)
model Matricula {
  id          Int      @id @default(autoincrement())
  estudanteId Int      @map("estudante_id")
  turmaId     Int      @map("turma_id")
  estado      String   @default("ativa") // ativa | suspensa | concluida | anulada
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turma     Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
  @@map("matriculas")
}

// unidade curricular ("cadeira") de uma turma
model UnidadeCurricular {
  id                 Int      @id @default(autoincrement())
  turmaId            Int      @map("turma_id")
  codigo             String
  nome               String
  periodo            String   @default("1") // "1" (1.º semestre) | "2" (2.º semestre) | "anual"
  horas              Int      @default(0)
  descricao          String   @default("")
  programa           String   @default("") // programa da cadeira escrito no portal (HTML filtrado)
  programaFicheiroId String?  @map("programa_ficheiro_id") // ou em documento (PDF, Word)
  notasPublicadas    String[] @default([]) @map("notas_publicadas") // componentes que os estudantes já veem

  turma            Turma              @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  docentes         Docencia[]
  materiais        Material[]
  avisos           AvisoCadeira[]
  pauta            NotaPauta[]
  trabalhos        Trabalho[]
  horarios         Horario[]
  aulas            Aula[]
  forumTopicos     ForumTopico[]
  eventoAcademicos EventoAcademico[]
  questionarios    Questionario[]
  secaoCadeiras    SecaoCadeira[]
  composicaoNotas  ComposicaoNota[]
  certificados     Certificado[]
  inqueritos       Inquerito[]
  grupos           GrupoCadeira[]
  membrosGrupos    MembroGrupo[]
  registos         RegistoAcesso[]
  subscricoesForum SubscricaoForum[]
  workshops        Workshop[]
  glossario        TermoGlossario[]
  paginasWiki      PaginaWiki[]
  inscricoes       InscricaoCadeira[]

  @@unique([turmaId, codigo])
  @@map("unidades_curriculares")
}

// alocação de docentes às cadeiras: um regente e, se for o caso, assistentes
model Docencia {
  cadeiraId Int    @map("cadeira_id")
  docenteId Int    @map("docente_id")
  papel     String @default("regente") // "regente" | "assistente"
  horas     Int    @default(0) // horas atribuídas a este docente na cadeira

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  docente ContaPortal       @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, docenteId])
  @@index([docenteId])
  @@map("docencias")
}

// ficheiro privado (materiais, entregas, documentos): só se descarrega pela API, com permissão
model Ficheiro {
  id       String   @id // identificador aleatório
  caminho  String // relativo à pasta privada
  nome     String
  tipo     String
  tamanho  Int
  donoId   Int?     @map("dono_id") // conta do portal que o enviou (se for o caso)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  entregas           EntregaFicheiro[]
  pastas             MaterialFicheiro[]
  anexosForum        ForumAnexo[]
  submissoesWorkshop SubmissaoWorkshop[]

  @@map("ficheiros_privados")
}

model Material {
  id           Int       @id @default(autoincrement())
  cadeiraId    Int       @map("cadeira_id")
  titulo       String
  descricao    String    @default("")
  secaoId      Int?      @map("secao_id") // capítulo da cadeira (null = secção geral)
  visivel      Boolean   @default(true) // escondida dos estudantes
  disponivelDe DateTime? @map("disponivel_de") @db.Timestamptz(3) // só abre a partir desta data
  requisitos   Json      @default("[]") // [{ tipo, id, notaMinima? }]: só abre depois de concluir estas
  tipo         String // ficheiro | ligacao | video | pagina | pasta | videoconferencia
  ficheiroId   String?   @map("ficheiro_id")
  url          String    @default("")
  conteudo     String    @default("") // página: texto (HTML filtrado)
  inicio       DateTime? @db.Timestamptz(3) // videoconferência: início da sessão
  duracao      Int? // videoconferência: minutos
  autorId      Int?      @map("autor_id")
  publicadoEm  DateTime  @default(now()) @map("publicado_em") @db.Timestamptz(3)

  cadeira    UnidadeCurricular  @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao      SecaoCadeira?      @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  conclusoes Conclusao[]
  ficheiros  MaterialFicheiro[]

  @@index([cadeiraId])
  @@map("materiais")
}

model AvisoCadeira {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  titulo    String
  texto     String
  autorId   Int?     @map("autor_id")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@index([cadeiraId])
  @@map("avisos_cadeira")
}

// avisos da Secretaria (a todos os estudantes ou a uma turma)
model AvisoGeral {
  id       Int      @id @default(autoincrement())
  turmaId  Int?     @map("turma_id")
  titulo   String
  texto    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@map("avisos_gerais")
}

// elemento de avaliação (teste, trabalho, exame) com peso na nota final
// pauta: uma linha por estudante e por cadeira (notas de 0 a 20; null = ainda sem nota)
model NotaPauta {
  cadeiraId    Int      @map("cadeira_id")
  estudanteId  Int      @map("estudante_id")
  p1           Decimal? @db.Decimal(4, 2) // 1.ª prova parcelar
  p2           Decimal? @db.Decimal(4, 2) // 2.ª prova parcelar
  exame        Decimal? @db.Decimal(4, 2) // exame da época normal
  recurso      Decimal? @db.Decimal(4, 2) // exame da época de recurso
  observacao   String   @default("")
  atualizadaEm DateTime @default(now()) @updatedAt @map("atualizada_em") @db.Timestamptz(3)

  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, estudanteId])
  @@index([estudanteId])
  @@map("pautas")
}

model Trabalho {
  id           Int       @id @default(autoincrement())
  cadeiraId    Int       @map("cadeira_id")
  titulo       String
  enunciado    String    @default("")
  prazo        DateTime  @db.Timestamptz(3)
  aceitaAtraso Boolean   @default(false) @map("aceita_atraso")
  ficheiroId   String?   @map("ficheiro_id") // enunciado em ficheiro (opcional)
  lembreteEm   DateTime? @map("lembrete_em") @db.Timestamptz(3) // quando se lembrou o prazo aos estudantes
  tipoEntrega  String    @default("ficheiro") @map("tipo_entrega") // ficheiro | texto | ambos
  maxFicheiros Int       @default(1) @map("max_ficheiros")
  grelha       Json      @default("[]") // grelha de avaliação: [{ criterio, descricao, pontos }]
  emGrupo      Boolean   @default(false) @map("em_grupo") // uma entrega por grupo, a nota vale para todos
  secaoId      Int?      @map("secao_id")
  visivel      Boolean   @default(true) // escondida dos estudantes
  disponivelDe DateTime? @map("disponivel_de") @db.Timestamptz(3) // só abre a partir desta data
  requisitos   Json      @default("[]") // [{ tipo, id, notaMinima? }]: só abre depois de concluir estas
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira      UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao        SecaoCadeira?     @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  entregas     Entrega[]
  prorrogacoes Prorrogacao[]

  @@index([cadeiraId])
  @@map("trabalhos")
}

model Entrega {
  id                 Int       @id @default(autoincrement())
  trabalhoId         Int       @map("trabalho_id")
  estudanteId        Int       @map("estudante_id")
  grupoId            Int?      @map("grupo_id") // trabalho em grupo: a entrega é do grupo (estudanteId = quem entregou)
  texto              String    @default("") // texto escrito no portal (entrega "online")
  comentario         String    @default("")
  entregueEm         DateTime  @default(now()) @map("entregue_em") @db.Timestamptz(3)
  correcaoFicheiroId String?   @map("correcao_ficheiro_id") // ficheiro de correção devolvido ao estudante
  grelha             Json      @default("{}") // pontos por critério da grelha de avaliação
  nota               Decimal?  @db.Decimal(4, 2)
  correcao           String    @default("")
  corrigidaEm        DateTime? @map("corrigida_em") @db.Timestamptz(3)

  trabalho  Trabalho          @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)
  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  ficheiros EntregaFicheiro[]
  grupo     GrupoCadeira?     @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([trabalhoId, estudanteId])
  @@unique([trabalhoId, grupoId])
  @@map("entregas")
}

// horário semanal de uma cadeira
model Horario {
  id        Int    @id @default(autoincrement())
  cadeiraId Int    @map("cadeira_id")
  diaSemana Int    @map("dia_semana") // 1 = segunda … 6 = sábado
  inicio    String // "08:00"
  fim       String
  sala      String @default("")

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@index([cadeiraId])
  @@map("horarios")
}

// aula dada (com sumário) e presenças
model Aula {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  data      String // "AAAA-MM-DD"
  sumario   String   @default("")
  criadaEm  DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  presencas Presenca[]

  @@index([cadeiraId])
  @@map("aulas")
}

model Presenca {
  aulaId      Int    @map("aula_id")
  estudanteId Int    @map("estudante_id")
  estado      String // presente | falta | justificada

  aula      Aula        @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([aulaId, estudanteId])
  @@map("presencas")
}

// pedido de documento à Secretaria (declarações, certificados)
model Pedido {
  id           Int      @id @default(autoincrement())
  estudanteId  Int      @map("estudante_id")
  tipo         String
  motivo       String   @default("")
  estado       String   @default("pendente") // pendente | em_tratamento | pronto | recusado
  resposta     String   @default("")
  ficheiroId   String?  @map("ficheiro_id") // documento pronto para descarregar
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@index([estudanteId])
  @@index([estado])
  @@map("pedidos")
}

// ---------- fórum de cada cadeira (como no Moodle) ----------

model ForumTopico {
  id              Int       @id @default(autoincrement())
  cadeiraId       Int       @map("cadeira_id")
  autorId         Int       @map("autor_id")
  titulo          String
  texto           String
  fixado          Boolean   @default(false) // o docente fixa no topo
  fechado         Boolean   @default(false) // sem novas respostas
  tipo            String    @default("discussao") // discussao | pergunta (perguntas e respostas: só vê as respostas quem respondeu)
  respostaCertaId Int?      @map("resposta_certa_id") // resposta marcada como certa (autor do tópico ou docente)
  editadoEm       DateTime? @map("editado_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atividadeEm     DateTime  @default(now()) @map("atividade_em") @db.Timestamptz(3) // última resposta

  cadeira     UnidadeCurricular  @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  autor       ContaPortal        @relation(fields: [autorId], references: [id], onDelete: Cascade)
  respostas   ForumResposta[]
  anexos      ForumAnexo[]
  subscricoes SubscricaoTopico[]

  @@index([cadeiraId, atividadeEm])
  @@map("forum_topicos")
}

model ForumResposta {
  id        Int       @id @default(autoincrement())
  topicoId  Int       @map("topico_id")
  autorId   Int       @map("autor_id")
  texto     String
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  editadoEm DateTime? @map("editado_em") @db.Timestamptz(3)

  topico ForumTopico  @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  autor  ContaPortal  @relation(fields: [autorId], references: [id], onDelete: Cascade)
  anexos ForumAnexo[]

  @@index([topicoId, criadoEm])
  @@map("forum_respostas")
}

// ---------- calendário académico ----------

// prova, exame, recurso de uma cadeira; ou evento geral / de uma turma (Administração Escolar)
model EventoAcademico {
  id        Int      @id @default(autoincrement())
  cadeiraId Int?     @map("cadeira_id")
  turmaId   Int?     @map("turma_id")
  tipo      String // p1 | p2 | exame | recurso | geral | feriado
  titulo    String
  data      String // AAAA-MM-DD
  inicio    String   @default("") // HH:MM (opcional)
  fim       String   @default("")
  local     String   @default("")
  descricao String   @default("")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular? @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  turma   Turma?             @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([data])
  @@map("eventos_academicos")
}

// ---------- progresso: materiais que o estudante já concluiu ----------

model Conclusao {
  materialId  Int      @map("material_id")
  estudanteId Int      @map("estudante_id")
  concluidoEm DateTime @default(now()) @map("concluido_em") @db.Timestamptz(3)

  material  Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([materialId, estudanteId])
  @@index([estudanteId])
  @@map("conclusoes")
}

// ---------- questionários online (correção automática) ----------

model Questionario {
  id                    Int       @id @default(autoincrement())
  cadeiraId             Int       @map("cadeira_id")
  titulo                String
  descricao             String    @default("")
  abre                  DateTime? @db.Timestamptz(3)
  fecha                 DateTime? @db.Timestamptz(3)
  duracao               Int       @default(0) // minutos por tentativa (0 = sem limite)
  tentativas            Int       @default(1) // tentativas permitidas
  publicado             Boolean   @default(false)
  mostrarRespostas      Boolean   @default(true) @map("mostrar_respostas") // mostrar as corretas depois de entregar
  baralhar              Boolean   @default(false) // baralhar perguntas e opções em cada tentativa
  perguntasPorTentativa Int       @default(0) @map("perguntas_por_tentativa") // sorteia N perguntas (0 = todas)
  secaoId               Int?      @map("secao_id")
  visivel               Boolean   @default(true) // escondida dos estudantes
  disponivelDe          DateTime? @map("disponivel_de") @db.Timestamptz(3) // só abre a partir desta data
  requisitos            Json      @default("[]") // [{ tipo, id, notaMinima? }]: só abre depois de concluir estas
  criadoEm              DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira    UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao      SecaoCadeira?     @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  perguntas  Pergunta[]
  realizadas Tentativa[]

  @@index([cadeiraId])
  @@map("questionarios")
}

model Pergunta {
  id             Int     @id @default(autoincrement())
  questionarioId Int     @map("questionario_id")
  ordem          Int     @default(0)
  enunciado      String
  tipo           String // unica | multipla | vf
  opcoes         Json // [{ texto, correta }]
  pontos         Decimal @default(1) @db.Decimal(5, 2)

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)

  @@index([questionarioId, ordem])
  @@map("perguntas")
}

model Tentativa {
  id             Int       @id @default(autoincrement())
  questionarioId Int       @map("questionario_id")
  estudanteId    Int       @map("estudante_id")
  numero         Int       @default(1)
  iniciadaEm     DateTime  @default(now()) @map("iniciada_em") @db.Timestamptz(3)
  limite         DateTime? @db.Timestamptz(3) // até quando se aceitam respostas
  entregueEm     DateTime? @map("entregue_em") @db.Timestamptz(3)
  respostas      Json      @default("{}") // { perguntaId: resposta (índices, texto ou número) }
  nota           Decimal?  @db.Decimal(4, 2) // 0 a 20 (null enquanto houver dissertações por corrigir)
  ordem          Json      @default("[]") // perguntas sorteadas para esta tentativa, pela ordem mostrada
  permutacoes    Json      @default("{}") // { perguntaId: [ordem das opções mostradas] }
  manuais        Json      @default("{}") // pontos dados pelo docente às dissertações { perguntaId: pontos }
  porCorrigir    Boolean   @default(false) @map("por_corrigir")
  comentario     String    @default("") // comentário do docente à tentativa

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  estudante    ContaPortal  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([questionarioId, estudanteId, numero])
  @@index([estudanteId])
  @@map("tentativas")
}

// capítulos da cadeira (as "secções" do Moodle): agrupam materiais, trabalhos e questionários
model SecaoCadeira {
  id           Int       @id @default(autoincrement())
  cadeiraId    Int       @map("cadeira_id")
  ordem        Int       @default(0)
  titulo       String
  resumo       String    @default("")
  visivel      Boolean   @default(true) // escondido dos estudantes enquanto o docente prepara
  disponivelDe DateTime? @map("disponivel_de") @db.Timestamptz(3) // o capítulo abre nesta data
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira       UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  materiais     Material[]
  trabalhos     Trabalho[]
  questionarios Questionario[]
  inqueritos    Inquerito[]
  workshops     Workshop[]

  @@index([cadeiraId, ordem])
  @@map("secoes_cadeira")
}

// ---------- notificações e mensagens ----------

// notificação no portal (o sino do cabeçalho); também vai por e-mail se a conta quiser
model Notificacao {
  id       Int      @id @default(autoincrement())
  contaId  Int      @map("conta_id")
  tipo     String // material | aviso | trabalho | correcao | notas | questionario | forum | mensagem | prazo | pedido | geral
  titulo   String
  texto    String   @default("")
  ligacao  String   @default("") // caminho no portal (ex.: /cadeiras/3?atividade=trabalho-5)
  lida     Boolean  @default(false)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  conta ContaPortal @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, lida, criadaEm])
  @@map("notificacoes")
}

// mensagens privadas entre contas do portal que partilham uma cadeira
model Mensagem {
  id       Int       @id @default(autoincrement())
  deId     Int       @map("de_id")
  paraId   Int       @map("para_id")
  texto    String
  lidaEm   DateTime? @map("lida_em") @db.Timestamptz(3)
  criadaEm DateTime  @default(now()) @map("criada_em") @db.Timestamptz(3)

  de   ContaPortal @relation("enviadas", fields: [deId], references: [id], onDelete: Cascade)
  para ContaPortal @relation("recebidas", fields: [paraId], references: [id], onDelete: Cascade)

  @@index([deId, paraId, criadaEm])
  @@index([paraId, lidaEm])
  @@map("mensagens")
}

// como se calcula uma componente da pauta a partir das atividades (como o livro de notas do Moodle)
model ComposicaoNota {
  cadeiraId  Int      @map("cadeira_id")
  componente String // p1 | p2 | exame | recurso
  itens      Json // [{ tipo: "trabalho" | "questionario", id, peso }]
  alteradaEm DateTime @default(now()) @updatedAt @map("alterada_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, componente])
  @@map("composicoes_nota")
}

// ficheiros de uma entrega (um trabalho pode pedir vários)
model EntregaFicheiro {
  entregaId  Int    @map("entrega_id")
  ficheiroId String @map("ficheiro_id")
  ordem      Int    @default(0)

  entrega  Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  ficheiro Ficheiro @relation(fields: [ficheiroId], references: [id], onDelete: Cascade)

  @@id([entregaId, ficheiroId])
  @@index([ficheiroId])
  @@map("entregas_ficheiros")
}

// prazo alargado só para um estudante (como as "extensões" do Moodle)
model Prorrogacao {
  trabalhoId  Int      @map("trabalho_id")
  estudanteId Int      @map("estudante_id")
  prazo       DateTime @db.Timestamptz(3)
  motivo      String   @default("")
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  trabalho Trabalho @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)

  @@id([trabalhoId, estudanteId])
  @@map("prorrogacoes")
}

// banco de perguntas do docente (reutilizável entre questionários e cadeiras)
model PerguntaBanco {
  id        Int      @id @default(autoincrement())
  docenteId Int      @map("docente_id")
  categoria String   @default("Geral")
  tipo      String
  enunciado String
  opcoes    Json
  pontos    Decimal  @default(1) @db.Decimal(5, 2)
  criadaEm  DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  docente ContaPortal @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@index([docenteId, categoria])
  @@map("banco_perguntas")
}

// certificado de conclusão de uma cadeira (verificável pelo código)
model Certificado {
  codigo      String   @id // código público de verificação
  estudanteId Int      @map("estudante_id")
  cadeiraId   Int      @map("cadeira_id")
  emitidoEm   DateTime @default(now()) @map("emitido_em") @db.Timestamptz(3)
  nota        Decimal? @db.Decimal(4, 2) // nota final da pauta no momento da emissão (se houver)

  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, cadeiraId])
  @@map("certificados")
}

// ficheiros de um material do tipo "pasta"
model MaterialFicheiro {
  materialId Int    @map("material_id")
  ficheiroId String @map("ficheiro_id")
  ordem      Int    @default(0)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  ficheiro Ficheiro @relation(fields: [ficheiroId], references: [id], onDelete: Cascade)

  @@id([materialId, ficheiroId])
  @@map("materiais_ficheiros")
}

// sondagem do docente ou inquérito de avaliação do docente (Administração Escolar)
model Inquerito {
  id           Int       @id @default(autoincrement())
  cadeiraId    Int       @map("cadeira_id")
  secaoId      Int?      @map("secao_id")
  tipo         String // sondagem | avaliacao
  titulo       String
  descricao    String    @default("")
  perguntas    Json // [{ tipo: escolha|escala|aberta, texto, opcoes?, multipla? }]
  anonimo      Boolean   @default(false)
  resultados   String    @default("apos_responder") // sondagem: apos_responder | apos_fecho | nunca
  fecha        DateTime? @db.Timestamptz(3)
  docenteId    Int?      @map("docente_id") // avaliação: o docente avaliado
  visivel      Boolean   @default(true)
  disponivelDe DateTime? @map("disponivel_de") @db.Timestamptz(3)
  requisitos   Json      @default("[]")
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira       UnidadeCurricular       @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao         SecaoCadeira?           @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  docente       ContaPortal?            @relation("avaliado", fields: [docenteId], references: [id], onDelete: SetNull)
  respostas     RespostaInquerito[]
  participacoes ParticipacaoInquerito[]

  @@index([cadeiraId])
  @@map("inqueritos")
}

// respostas: sem estudante quando o inquérito é anónimo
model RespostaInquerito {
  id          Int      @id @default(autoincrement())
  inqueritoId Int      @map("inquerito_id")
  estudanteId Int?     @map("estudante_id")
  respostas   Json
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  inquerito Inquerito @relation(fields: [inqueritoId], references: [id], onDelete: Cascade)

  @@unique([inqueritoId, estudanteId])
  @@map("respostas_inqueritos")
}

// quem já respondeu (separado das respostas, para o anonimato)
model ParticipacaoInquerito {
  inqueritoId Int      @map("inquerito_id")
  estudanteId Int      @map("estudante_id")
  em          DateTime @default(now()) @db.Timestamptz(3)

  inquerito Inquerito   @relation(fields: [inqueritoId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([inqueritoId, estudanteId])
  @@map("participacoes_inqueritos")
}

// grupos de estudantes dentro de uma cadeira (trabalhos em grupo)
model GrupoCadeira {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  nome      String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira  UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  membros  MembroGrupo[]
  entregas Entrega[]

  @@unique([cadeiraId, nome])
  @@map("grupos_cadeira")
}

// cada estudante está, no máximo, num grupo de cada cadeira
model MembroGrupo {
  grupoId     Int @map("grupo_id")
  cadeiraId   Int @map("cadeira_id")
  estudanteId Int @map("estudante_id")

  grupo     GrupoCadeira      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([grupoId, estudanteId])
  @@unique([cadeiraId, estudanteId])
  @@map("membros_grupos")
}

// registo de acessos dos estudantes (quem abriu o quê e quando), para os relatórios do docente
model RegistoAcesso {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  contaId   Int      @map("conta_id")
  tipo      String // cadeira | material | trabalho | questionario | inquerito | forum
  alvoId    Int?     @map("alvo_id")
  em        DateTime @default(now()) @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  conta   ContaPortal       @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([cadeiraId, em])
  @@index([cadeiraId, contaId])
  @@map("registos_acesso")
}

// anexos de um tópico ou de uma resposta do fórum
model ForumAnexo {
  id         Int    @id @default(autoincrement())
  ficheiroId String @unique @map("ficheiro_id")
  topicoId   Int?   @map("topico_id")
  respostaId Int?   @map("resposta_id")

  ficheiro Ficheiro       @relation(fields: [ficheiroId], references: [id], onDelete: Cascade)
  topico   ForumTopico?   @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  resposta ForumResposta? @relation(fields: [respostaId], references: [id], onDelete: Cascade)

  @@map("forum_anexos")
}

// seguir um tópico (ativa = false: deixou de seguir, mesmo tendo escrito nele)
model SubscricaoTopico {
  topicoId Int     @map("topico_id")
  contaId  Int     @map("conta_id")
  ativa    Boolean @default(true)

  topico ForumTopico @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  conta  ContaPortal @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@id([topicoId, contaId])
  @@map("subscricoes_topicos")
}

// seguir o fórum inteiro de uma cadeira (avisos de tópicos novos e de todas as respostas)
model SubscricaoForum {
  cadeiraId Int @map("cadeira_id")
  contaId   Int @map("conta_id")

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  conta   ContaPortal       @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, contaId])
  @@map("subscricoes_foruns")
}

// avaliação por pares ("Workshop" do Moodle): os estudantes entregam e avaliam trabalhos uns dos outros
model Workshop {
  id               Int       @id @default(autoincrement())
  cadeiraId        Int       @map("cadeira_id")
  secaoId          Int?      @map("secao_id")
  titulo           String
  enunciado        String    @default("")
  grelha           Json // critérios com pontos, para os pares avaliarem
  fimSubmissao     DateTime  @map("fim_submissao") @db.Timestamptz(3)
  fimAvaliacao     DateTime  @map("fim_avaliacao") @db.Timestamptz(3)
  avaliacoesPorPar Int       @default(3) @map("avaliacoes_por_par") // quantos trabalhos cada estudante avalia
  anonimo          Boolean   @default(true) // quem avalia não vê o autor; o autor não vê quem o avaliou
  distribuidoEm    DateTime? @map("distribuido_em") @db.Timestamptz(3)
  visivel          Boolean   @default(true)
  disponivelDe     DateTime? @map("disponivel_de") @db.Timestamptz(3)
  requisitos       Json      @default("[]")
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira    UnidadeCurricular   @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao      SecaoCadeira?       @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  submissoes SubmissaoWorkshop[]

  @@index([cadeiraId])
  @@map("workshops")
}

model SubmissaoWorkshop {
  id          Int      @id @default(autoincrement())
  workshopId  Int      @map("workshop_id")
  estudanteId Int      @map("estudante_id")
  texto       String   @default("")
  ficheiroId  String?  @map("ficheiro_id")
  entregueEm  DateTime @default(now()) @map("entregue_em") @db.Timestamptz(3)
  notaFinal   Decimal? @map("nota_final") @db.Decimal(4, 2) // o docente pode substituir a média dos pares
  comentario  String   @default("") // comentário do docente

  workshop   Workshop       @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  estudante  ContaPortal    @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  ficheiro   Ficheiro?      @relation(fields: [ficheiroId], references: [id], onDelete: SetNull)
  avaliacoes AvaliacaoPar[]

  @@unique([workshopId, estudanteId])
  @@map("submissoes_workshop")
}

model AvaliacaoPar {
  id          Int       @id @default(autoincrement())
  submissaoId Int       @map("submissao_id")
  avaliadorId Int       @map("avaliador_id")
  pontos      Json      @default("{}")
  comentario  String    @default("")
  nota        Decimal?  @db.Decimal(4, 2)
  feitaEm     DateTime? @map("feita_em") @db.Timestamptz(3)

  submissao SubmissaoWorkshop @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  avaliador ContaPortal       @relation(fields: [avaliadorId], references: [id], onDelete: Cascade)

  @@unique([submissaoId, avaliadorId])
  @@map("avaliacoes_pares")
}

// glossário da cadeira: termos propostos por estudantes (o docente aprova) e pelo docente
model TermoGlossario {
  id           Int      @id @default(autoincrement())
  cadeiraId    Int      @map("cadeira_id")
  termo        String
  definicao    String
  autorId      Int      @map("autor_id")
  aprovado     Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  autor   ContaPortal       @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([cadeiraId, termo])
  @@map("glossario")
}

// wiki da cadeira: páginas escritas em conjunto, com todas as versões
model PaginaWiki {
  id           Int      @id @default(autoincrement())
  cadeiraId    Int      @map("cadeira_id")
  titulo       String
  criadaEm     DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  atualizadaEm DateTime @default(now()) @map("atualizada_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  versoes VersaoWiki[]

  @@unique([cadeiraId, titulo])
  @@map("paginas_wiki")
}

model VersaoWiki {
  id       Int      @id @default(autoincrement())
  paginaId Int      @map("pagina_id")
  conteudo String // HTML filtrado
  resumo   String   @default("") // o que mudou
  autorId  Int      @map("autor_id")
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  pagina PaginaWiki  @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  autor  ContaPortal @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([paginaId, id])
  @@map("versoes_wiki")
}

// inscrição de um estudante numa cadeira fora da sua turma (atraso, repetição, equivalência)
model InscricaoCadeira {
  id          Int      @id @default(autoincrement())
  estudanteId Int      @map("estudante_id")
  cadeiraId   Int      @map("cadeira_id")
  motivo      String // atraso | repeticao | equivalencia | outro
  observacao  String   @default("")
  estado      String   @default("ativa") // ativa | anulada
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, cadeiraId])
  @@index([cadeiraId])
  @@map("inscricoes_cadeiras")
}

// trabalho de fim de curso (monografia/TFC) de um estudante finalista, lançado pela Administração Escolar
model TrabalhoFimCurso {
  id           Int      @id @default(autoincrement())
  estudanteId  Int      @map("estudante_id")
  turmaId      Int      @map("turma_id")
  tema         String
  orientador   String   @default("")
  juri         String   @default("")
  dataDefesa   String?  @map("data_defesa") // AAAA-MM-DD
  nota         Decimal? @db.Decimal(4, 2)
  observacao   String   @default("")
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turma     Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
  @@map("trabalhos_fim_curso")
}

// certificado de conclusão do curso (documento final), com código de verificação
model CertificadoCurso {
  codigo      String   @id
  estudanteId Int      @map("estudante_id")
  turmaId     Int      @map("turma_id")
  curso       String
  media       Decimal  @db.Decimal(4, 2)
  notaTfc     Decimal? @map("nota_tfc") @db.Decimal(4, 2)
  emitidoEm   DateTime @default(now()) @map("emitido_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turma     Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
  @@map("certificados_curso")
}

// inquérito institucional (satisfação com os serviços, o curso, a Escola), da Administração Escolar
model InqueritoInstitucional {
  id        Int       @id @default(autoincrement())
  titulo    String
  descricao String    @default("")
  perguntas Json // [{ tipo: escala|escolha|aberta, texto, opcoes?, multipla? }]
  publico   String // estudantes | docentes | todos
  turmaIds  Json      @default("[]") @map("turma_ids") // só estas turmas (vazio = todas)
  fecha     DateTime  @db.Timestamptz(3)
  lancadoEm DateTime? @map("lancado_em") @db.Timestamptz(3) // null = rascunho
  autor     String    @default("")
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  respostas     RespostaInstitucional[]
  participacoes ParticipacaoInstitucional[]

  @@map("inqueritos_institucionais")
}

// respostas sempre anónimas (sem ligação a quem respondeu)
model RespostaInstitucional {
  id          Int      @id @default(autoincrement())
  inqueritoId Int      @map("inquerito_id")
  respostas   Json
  criadaEm    DateTime @map("criada_em") @db.Timestamptz(3)

  inquerito InqueritoInstitucional @relation(fields: [inqueritoId], references: [id], onDelete: Cascade)

  @@index([inqueritoId])
  @@map("respostas_institucionais")
}

model ParticipacaoInstitucional {
  inqueritoId Int      @map("inquerito_id")
  contaId     Int      @map("conta_id")
  em          DateTime @db.Timestamptz(3)

  inquerito InqueritoInstitucional @relation(fields: [inqueritoId], references: [id], onDelete: Cascade)
  conta     ContaPortal            @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@id([inqueritoId, contaId])
  @@map("participacoes_institucionais")
}
