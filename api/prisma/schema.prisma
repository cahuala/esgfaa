// Modelo de dados da API (PostgreSQL). Alterações: npx prisma migrate dev --name <descricao>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// notícias, artigos, eventos, cursos, pessoas e banners
model Item {
  colecao       String
  id            String
  dados         Json
  ordem         Int         @default(0)
  estado        String      @default("publicado")
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime    @default(now()) @map("atualizado_em") @db.Timestamptz(3)
  criadoPor     Int?        @map("criado_por")
  atualizadoPor Int?        @map("atualizado_por")
  autorEdicao   Utilizador? @relation("edicoes", fields: [atualizadoPor], references: [id], onDelete: SetNull)

  @@id([colecao, id])
  @@index([colecao, estado])
  @@map("itens")
}

// conteúdo editável das páginas (início, instituição, contactos, cursos)
model Pagina {
  chave         String   @id
  dados         Json
  atualizadoEm  DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)
  atualizadoPor Int?     @map("atualizado_por")

  @@map("paginas")
}

model Utilizador {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String    @unique
  senha              String
  papel              String
  ativo              Boolean   @default(true)
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoAcesso       DateTime? @map("ultimo_acesso") @db.Timestamptz(3)
  tentativasFalhadas Int       @default(0) @map("tentativas_falhadas")
  bloqueadoAte       DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  versaoToken        Int       @default(0) @map("versao_token")
  deveMudarSenha     Boolean   @default(false) @map("deve_mudar_senha")
  edicoes            Item[]    @relation("edicoes")

  @@index([papel])
  @@map("utilizadores")
}

model Papel {
  id         String   @id
  nome       String
  descricao  String   @default("")
  permissoes Json     @default("[]")
  sistema    Boolean  @default(false)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@map("papeis")
}

// registo de auditoria
model Atividade {
  id             Int      @id @default(autoincrement())
  utilizadorId   Int?     @map("utilizador_id")
  utilizadorNome String?  @map("utilizador_nome")
  acao           String
  colecao        String?
  alvoId         String?  @map("alvo_id")
  alvoTitulo     String?  @map("alvo_titulo")
  detalhes       String?
  ip             String?
  agente         String?
  data           DateTime @default(now()) @db.Timestamptz(3)

  @@index([data(sort: Desc)])
  @@index([utilizadorId])
  @@index([acao])
  @@map("atividades")
}

model Gosto {
  colecao   String
  itemId    String   @map("item_id")
  visitante String
  data      DateTime @default(now()) @db.Timestamptz(3)

  @@id([colecao, itemId, visitante])
  @@map("gostos")
}

model Comentario {
  id      Int      @id @default(autoincrement())
  colecao String
  itemId  String   @map("item_id")
  nome    String
  texto   String
  ip      String?
  data    DateTime @default(now()) @db.Timestamptz(3)

  @@index([colecao, itemId])
  @@index([data(sort: Desc)])
  @@map("comentarios")
}

model Visualizacao {
  colecao String
  itemId  String @map("item_id")
  total   Int    @default(0)

  @@id([colecao, itemId])
  @@map("visualizacoes")
}

// páginas vistas no site (sem IP nem agente completo)
model Visita {
  id          Int      @id @default(autoincrement())
  data        DateTime @default(now()) @db.Timestamptz(3)
  visitante   String
  caminho     String
  origem      String?
  dispositivo String?
  navegador   String?

  @@index([data])
  @@index([visitante])
  @@map("visitas")
}

model PublicidadeMetrica {
  bannerId   String   @map("banner_id")
  dia        DateTime @db.Date
  impressoes Int      @default(0)
  cliques    Int      @default(0)

  @@id([bannerId, dia])
  @@map("publicidade_metricas")
}

// sessões terminadas antes de expirarem
model SessaoRevogada {
  jti    String   @id
  expira DateTime @db.Timestamptz(3)

  @@index([expira])
  @@map("sessoes_revogadas")
}

// candidaturas aos cursos (formulário público por passos; avaliadas pela Secretaria Académica)
model Candidatura {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  curso         String
  nome          String
  email         String
  telefone      String
  dados         Json
  estado        String   @default("recebida")
  notas         String   @default("")
  ip            String?
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)
  atualizadaEm  DateTime @default(now()) @map("atualizada_em") @db.Timestamptz(3)
  atualizadaPor Int?     @map("atualizada_por")

  @@index([estado])
  @@index([curso])
  @@index([email])
  @@index([criadaEm(sort: Desc)])
  @@map("candidaturas")
}

// ======================= Portal académico =======================

// conta do portal: estudante ou docente (separada das contas do painel)
model ContaPortal {
  id                 Int       @id @default(autoincrement())
  tipo               String // "estudante" | "docente"
  numero             String    @unique // n.º de estudante ou de docente
  nome               String
  email              String    @unique
  senha              String
  ativo              Boolean   @default(true)
  dados              Json      @default("{}") // posto, ramo, telefone, …
  criadoEm           DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimoAcesso       DateTime? @map("ultimo_acesso") @db.Timestamptz(3)
  tentativasFalhadas Int       @default(0) @map("tentativas_falhadas")
  bloqueadoAte       DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  versaoToken        Int       @default(0) @map("versao_token")
  deveMudarSenha     Boolean   @default(true) @map("deve_mudar_senha")
  notificarEmail     Boolean   @default(true) @map("notificar_email") // receber também por e-mail

  matriculas         Matricula[]
  docencias          Docencia[]
  topicos            ForumTopico[]
  respostas          ForumResposta[]
  conclusoes         Conclusao[]
  tentativas         Tentativa[]
  notificacoes       Notificacao[]
  mensagensEnviadas  Mensagem[]      @relation("enviadas")
  mensagensRecebidas Mensagem[]      @relation("recebidas")
  notas              NotaPauta[]
  entregas           Entrega[]
  presencas          Presenca[]
  pedidos            Pedido[]

  @@index([tipo])
  @@map("contas_portal")
}

// turma de um curso num ano letivo (ex.: CEM 2026/2027)
model Turma {
  id            Int      @id @default(autoincrement())
  curso         String // identificador do curso (coleção "cursos")
  anoLetivo     String   @map("ano_letivo")
  anoCurricular Int      @default(1) @map("ano_curricular") // 1.º ano, 2.º ano, …
  nome          String
  ativa         Boolean  @default(true)
  criadaEm      DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  cadeiras   UnidadeCurricular[]
  matriculas Matricula[]
  avisos     AvisoGeral[]
  eventos    EventoAcademico[]

  @@unique([curso, anoLetivo, nome])
  @@map("turmas")
}

// matrícula de um estudante numa turma (feita pela Secretaria)
model Matricula {
  id          Int      @id @default(autoincrement())
  estudanteId Int      @map("estudante_id")
  turmaId     Int      @map("turma_id")
  estado      String   @default("ativa") // ativa | suspensa | concluida | anulada
  criadaEm    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  turma     Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([estudanteId, turmaId])
  @@map("matriculas")
}

// unidade curricular ("cadeira") de uma turma
model UnidadeCurricular {
  id                 Int      @id @default(autoincrement())
  turmaId            Int      @map("turma_id")
  codigo             String
  nome               String
  periodo            String   @default("1") // "1" (1.º semestre) | "2" (2.º semestre) | "anual"
  horas              Int      @default(0)
  descricao          String   @default("")
  programa           String   @default("") // programa da cadeira escrito no portal (HTML filtrado)
  programaFicheiroId String?  @map("programa_ficheiro_id") // ou em documento (PDF, Word)
  notasPublicadas    String[] @default([]) @map("notas_publicadas") // componentes que os estudantes já veem

  turma            Turma             @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  docentes         Docencia[]
  materiais        Material[]
  avisos           AvisoCadeira[]
  pauta            NotaPauta[]
  trabalhos        Trabalho[]
  horarios         Horario[]
  aulas            Aula[]
  forumTopicos     ForumTopico[]
  eventoAcademicos EventoAcademico[]
  questionarios    Questionario[]
  secaoCadeiras    SecaoCadeira[]
  composicaoNotas  ComposicaoNota[]

  @@unique([turmaId, codigo])
  @@map("unidades_curriculares")
}

// alocação de docentes às cadeiras: um regente e, se for o caso, assistentes
model Docencia {
  cadeiraId Int    @map("cadeira_id")
  docenteId Int    @map("docente_id")
  papel     String @default("regente") // "regente" | "assistente"
  horas     Int    @default(0) // horas atribuídas a este docente na cadeira

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  docente ContaPortal       @relation(fields: [docenteId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, docenteId])
  @@index([docenteId])
  @@map("docencias")
}

// ficheiro privado (materiais, entregas, documentos): só se descarrega pela API, com permissão
model Ficheiro {
  id       String   @id // identificador aleatório
  caminho  String // relativo à pasta privada
  nome     String
  tipo     String
  tamanho  Int
  donoId   Int?     @map("dono_id") // conta do portal que o enviou (se for o caso)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@map("ficheiros_privados")
}

model Material {
  id          Int      @id @default(autoincrement())
  cadeiraId   Int      @map("cadeira_id")
  titulo      String
  descricao   String   @default("")
  secaoId     Int?     @map("secao_id") // capítulo da cadeira (null = secção geral)
  tipo        String // ficheiro | ligacao | video
  ficheiroId  String?  @map("ficheiro_id")
  url         String   @default("")
  autorId     Int?     @map("autor_id")
  publicadoEm DateTime @default(now()) @map("publicado_em") @db.Timestamptz(3)

  cadeira    UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao      SecaoCadeira?     @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  conclusoes Conclusao[]

  @@index([cadeiraId])
  @@map("materiais")
}

model AvisoCadeira {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  titulo    String
  texto     String
  autorId   Int?     @map("autor_id")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@index([cadeiraId])
  @@map("avisos_cadeira")
}

// avisos da Secretaria (a todos os estudantes ou a uma turma)
model AvisoGeral {
  id       Int      @id @default(autoincrement())
  turmaId  Int?     @map("turma_id")
  titulo   String
  texto    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  turma Turma? @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@map("avisos_gerais")
}

// elemento de avaliação (teste, trabalho, exame) com peso na nota final
// pauta: uma linha por estudante e por cadeira (notas de 0 a 20; null = ainda sem nota)
model NotaPauta {
  cadeiraId    Int      @map("cadeira_id")
  estudanteId  Int      @map("estudante_id")
  p1           Decimal? @db.Decimal(4, 2) // 1.ª prova parcelar
  p2           Decimal? @db.Decimal(4, 2) // 2.ª prova parcelar
  exame        Decimal? @db.Decimal(4, 2) // exame da época normal
  recurso      Decimal? @db.Decimal(4, 2) // exame da época de recurso
  observacao   String   @default("")
  atualizadaEm DateTime @default(now()) @updatedAt @map("atualizada_em") @db.Timestamptz(3)

  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  estudante ContaPortal       @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, estudanteId])
  @@index([estudanteId])
  @@map("pautas")
}

model Trabalho {
  id           Int       @id @default(autoincrement())
  cadeiraId    Int       @map("cadeira_id")
  titulo       String
  enunciado    String    @default("")
  prazo        DateTime  @db.Timestamptz(3)
  aceitaAtraso Boolean   @default(false) @map("aceita_atraso")
  ficheiroId   String?   @map("ficheiro_id") // enunciado em ficheiro (opcional)
  lembreteEm   DateTime? @map("lembrete_em") @db.Timestamptz(3) // quando se lembrou o prazo aos estudantes
  secaoId      Int?      @map("secao_id")
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira  UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao    SecaoCadeira?     @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  entregas Entrega[]

  @@index([cadeiraId])
  @@map("trabalhos")
}

model Entrega {
  id          Int       @id @default(autoincrement())
  trabalhoId  Int       @map("trabalho_id")
  estudanteId Int       @map("estudante_id")
  ficheiroId  String    @map("ficheiro_id")
  comentario  String    @default("")
  entregueEm  DateTime  @default(now()) @map("entregue_em") @db.Timestamptz(3)
  nota        Decimal?  @db.Decimal(4, 2)
  correcao    String    @default("")
  corrigidaEm DateTime? @map("corrigida_em") @db.Timestamptz(3)

  trabalho  Trabalho    @relation(fields: [trabalhoId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([trabalhoId, estudanteId])
  @@map("entregas")
}

// horário semanal de uma cadeira
model Horario {
  id        Int    @id @default(autoincrement())
  cadeiraId Int    @map("cadeira_id")
  diaSemana Int    @map("dia_semana") // 1 = segunda … 6 = sábado
  inicio    String // "08:00"
  fim       String
  sala      String @default("")

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@index([cadeiraId])
  @@map("horarios")
}

// aula dada (com sumário) e presenças
model Aula {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  data      String // "AAAA-MM-DD"
  sumario   String   @default("")
  criadaEm  DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  presencas Presenca[]

  @@index([cadeiraId])
  @@map("aulas")
}

model Presenca {
  aulaId      Int    @map("aula_id")
  estudanteId Int    @map("estudante_id")
  estado      String // presente | falta | justificada

  aula      Aula        @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([aulaId, estudanteId])
  @@map("presencas")
}

// pedido de documento à Secretaria (declarações, certificados)
model Pedido {
  id           Int      @id @default(autoincrement())
  estudanteId  Int      @map("estudante_id")
  tipo         String
  motivo       String   @default("")
  estado       String   @default("pendente") // pendente | em_tratamento | pronto | recusado
  resposta     String   @default("")
  ficheiroId   String?  @map("ficheiro_id") // documento pronto para descarregar
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(3)

  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@index([estudanteId])
  @@index([estado])
  @@map("pedidos")
}

// ---------- fórum de cada cadeira (como no Moodle) ----------

model ForumTopico {
  id          Int      @id @default(autoincrement())
  cadeiraId   Int      @map("cadeira_id")
  autorId     Int      @map("autor_id")
  titulo      String
  texto       String
  fixado      Boolean  @default(false) // o docente fixa no topo
  fechado     Boolean  @default(false) // sem novas respostas
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atividadeEm DateTime @default(now()) @map("atividade_em") @db.Timestamptz(3) // última resposta

  cadeira   UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  autor     ContaPortal       @relation(fields: [autorId], references: [id], onDelete: Cascade)
  respostas ForumResposta[]

  @@index([cadeiraId, atividadeEm])
  @@map("forum_topicos")
}

model ForumResposta {
  id       Int      @id @default(autoincrement())
  topicoId Int      @map("topico_id")
  autorId  Int      @map("autor_id")
  texto    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  topico ForumTopico @relation(fields: [topicoId], references: [id], onDelete: Cascade)
  autor  ContaPortal @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([topicoId, criadoEm])
  @@map("forum_respostas")
}

// ---------- calendário académico ----------

// prova, exame, recurso de uma cadeira; ou evento geral / de uma turma (Administração Escolar)
model EventoAcademico {
  id        Int      @id @default(autoincrement())
  cadeiraId Int?     @map("cadeira_id")
  turmaId   Int?     @map("turma_id")
  tipo      String // p1 | p2 | exame | recurso | geral | feriado
  titulo    String
  data      String // AAAA-MM-DD
  inicio    String   @default("") // HH:MM (opcional)
  fim       String   @default("")
  local     String   @default("")
  descricao String   @default("")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular? @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  turma   Turma?             @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([data])
  @@map("eventos_academicos")
}

// ---------- progresso: materiais que o estudante já concluiu ----------

model Conclusao {
  materialId  Int      @map("material_id")
  estudanteId Int      @map("estudante_id")
  concluidoEm DateTime @default(now()) @map("concluido_em") @db.Timestamptz(3)

  material  Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  estudante ContaPortal @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@id([materialId, estudanteId])
  @@index([estudanteId])
  @@map("conclusoes")
}

// ---------- questionários online (correção automática) ----------

model Questionario {
  id               Int       @id @default(autoincrement())
  cadeiraId        Int       @map("cadeira_id")
  titulo           String
  descricao        String    @default("")
  abre             DateTime? @db.Timestamptz(3)
  fecha            DateTime? @db.Timestamptz(3)
  duracao          Int       @default(0) // minutos por tentativa (0 = sem limite)
  tentativas       Int       @default(1) // tentativas permitidas
  publicado        Boolean   @default(false)
  mostrarRespostas Boolean   @default(true) @map("mostrar_respostas") // mostrar as corretas depois de entregar
  secaoId          Int?      @map("secao_id")
  criadoEm         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira    UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  secao      SecaoCadeira?     @relation(fields: [secaoId], references: [id], onDelete: SetNull)
  perguntas  Pergunta[]
  realizadas Tentativa[]

  @@index([cadeiraId])
  @@map("questionarios")
}

model Pergunta {
  id             Int     @id @default(autoincrement())
  questionarioId Int     @map("questionario_id")
  ordem          Int     @default(0)
  enunciado      String
  tipo           String // unica | multipla | vf
  opcoes         Json // [{ texto, correta }]
  pontos         Decimal @default(1) @db.Decimal(5, 2)

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)

  @@index([questionarioId, ordem])
  @@map("perguntas")
}

model Tentativa {
  id             Int       @id @default(autoincrement())
  questionarioId Int       @map("questionario_id")
  estudanteId    Int       @map("estudante_id")
  numero         Int       @default(1)
  iniciadaEm     DateTime  @default(now()) @map("iniciada_em") @db.Timestamptz(3)
  limite         DateTime? @db.Timestamptz(3) // até quando se aceitam respostas
  entregueEm     DateTime? @map("entregue_em") @db.Timestamptz(3)
  respostas      Json      @default("{}") // { perguntaId: [índices escolhidos] }
  nota           Decimal?  @db.Decimal(4, 2) // 0 a 20

  questionario Questionario @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  estudante    ContaPortal  @relation(fields: [estudanteId], references: [id], onDelete: Cascade)

  @@unique([questionarioId, estudanteId, numero])
  @@index([estudanteId])
  @@map("tentativas")
}

// capítulos da cadeira (as "secções" do Moodle): agrupam materiais, trabalhos e questionários
model SecaoCadeira {
  id        Int      @id @default(autoincrement())
  cadeiraId Int      @map("cadeira_id")
  ordem     Int      @default(0)
  titulo    String
  resumo    String   @default("")
  visivel   Boolean  @default(true) // escondido dos estudantes enquanto o docente prepara
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  cadeira       UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)
  materiais     Material[]
  trabalhos     Trabalho[]
  questionarios Questionario[]

  @@index([cadeiraId, ordem])
  @@map("secoes_cadeira")
}

// ---------- notificações e mensagens ----------

// notificação no portal (o sino do cabeçalho); também vai por e-mail se a conta quiser
model Notificacao {
  id       Int      @id @default(autoincrement())
  contaId  Int      @map("conta_id")
  tipo     String // material | aviso | trabalho | correcao | notas | questionario | forum | mensagem | prazo | pedido | geral
  titulo   String
  texto    String   @default("")
  ligacao  String   @default("") // caminho no portal (ex.: /cadeiras/3?atividade=trabalho-5)
  lida     Boolean  @default(false)
  criadaEm DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  conta ContaPortal @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, lida, criadaEm])
  @@map("notificacoes")
}

// mensagens privadas entre contas do portal que partilham uma cadeira
model Mensagem {
  id       Int       @id @default(autoincrement())
  deId     Int       @map("de_id")
  paraId   Int       @map("para_id")
  texto    String
  lidaEm   DateTime? @map("lida_em") @db.Timestamptz(3)
  criadaEm DateTime  @default(now()) @map("criada_em") @db.Timestamptz(3)

  de   ContaPortal @relation("enviadas", fields: [deId], references: [id], onDelete: Cascade)
  para ContaPortal @relation("recebidas", fields: [paraId], references: [id], onDelete: Cascade)

  @@index([deId, paraId, criadaEm])
  @@index([paraId, lidaEm])
  @@map("mensagens")
}

// como se calcula uma componente da pauta a partir das atividades (como o livro de notas do Moodle)
model ComposicaoNota {
  cadeiraId  Int      @map("cadeira_id")
  componente String // p1 | p2 | exame | recurso
  itens      Json // [{ tipo: "trabalho" | "questionario", id, peso }]
  alteradaEm DateTime @default(now()) @updatedAt @map("alterada_em") @db.Timestamptz(3)

  cadeira UnidadeCurricular @relation(fields: [cadeiraId], references: [id], onDelete: Cascade)

  @@id([cadeiraId, componente])
  @@map("composicoes_nota")
}
