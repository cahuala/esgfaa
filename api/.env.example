# Copie para .env e ajuste. Em produção defina sempre JWT_SECRET e ADMIN_PASSWORD.
PORT=3001
NODE_ENV=development
# Segredo longo e aleatório para assinar as sessões (ex.: openssl rand -hex 32)
JWT_SECRET=
# Endereço público desta API (para os URLs das imagens). Vazio = deduzido do pedido.
PUBLIC_URL=
# Sites autorizados a usar a API, separados por vírgulas
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://cahuala.github.io
# Base de dados PostgreSQL (em desenvolvimento: docker compose up -d, na raiz do repositório)
DATABASE_URL=postgresql://esgfaa:esgfaa_dev@localhost:5434/esgfaa
# Domínio do e-mail das contas do portal académico (estudantes e docentes)
EMAIL_DOMINIO_ESCOLA=esgfaa.gov.ao
# Fuso horário das estatísticas (dias e horas)
FUSO_HORARIO=Africa/Luanda
# Pasta dos ficheiros carregados (disco persistente em produção)
DATA_DIR=dados
# Administrador criado no primeiro arranque
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@esgfaa.gov.ao
ADMIN_PASSWORD=
# Atrás de um proxy (Render, Nginx…): número de proxies de confiança
TRUST_PROXY=
MAX_UPLOAD_MB=80

# Notificações por e-mail (opcional; sem SMTP_URL ficam só no portal)
# SMTP_URL=smtps://utilizador%40dominio:senha@smtp.servidor.ao:465
# EMAIL_REMETENTE=Portal Académico ESG <portal@esgfaa.gov.ao>
# PORTAL_URL=https://cahuala.github.io/esgfaa/portal/

# Anti-plágio: pesquisa de trabalhos iguais na internet (opcional; https://brave.com/search/api/)
# Envia ao Brave algumas frases de cada trabalho analisado.
# BRAVE_API_KEY=
# PESQUISAS_WEB_POR_DOCUMENTO=8
# Avaliação de utilização de IA e tradução automática do site (opcional; https://console.anthropic.com)
# Envia ao Claude o texto do trabalho (avaliação de IA) ou do conteúdo (tradução).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-sonnet-5-5

# Tradução automática do site sem custos: LibreTranslate no próprio servidor (docker compose up -d tradutor).
# Usado quando não há ANTHROPIC_API_KEY. Os textos não saem da Escola.
# LIBRETRANSLATE_URL=http://127.0.0.1:5005
# LIBRETRANSLATE_CHAVE=

# Avisos no telemóvel (Web Push). Opcional: sem estas chaves, o servidor cria-as na primeira vez
# e guarda-as em DATA_DIR/vapid.json (faça cópia de segurança desse ficheiro: se mudar, os
# aparelhos têm de voltar a ligar os avisos). Para gerar: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:geral@esgfaa.gov.ao

# Sistema de Gestão de Pessoal (rede interna): envia os docentes e estudantes para as contas do portal.
# A mesma chave (32+ caracteres) no INTEGRACAO_CHAVE do servidor interno. Vazio = entrada desligada.
INTEGRACAO_CHAVE=

# Lei n.º 22/11 (protecção de dados): IA e pesquisa externas (fora de Angola) só com autorização da Escola
DADOS_FORA_DE_ANGOLA=nao
# prazos de conservação (meses) dos registos com dados pessoais
CONSERVAR_CONTACTOS_MESES=24
CONSERVAR_ATIVIDADES_MESES=60
CONSERVAR_SEGURANCA_MESES=12
CONSERVAR_ACESSOS_MESES=24
CONSERVAR_IP_COMENTARIOS_MESES=1
