{
  "name": "esgfaa-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API do site da Escola Superior de Guerra: conteúdos, utilizadores, atividades, gostos e comentários",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "prisma migrate deploy && node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:cobertura": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/**/*.test.js\"",
    "migrar": "prisma migrate deploy",
    "importar-sqlite": "node --env-file-if-exists=.env scripts/importar-sqlite.js",
    "postinstall": "prisma generate",
    "semear-portal": "node --env-file-if-exists=.env scripts/semear-portal.js",
    "carga": "node --env-file-if-exists=.env scripts/carga.mjs",
    "otimizar-imagens": "node --env-file-if-exists=.env scripts/otimizar-imagens.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "h5p-standalone": "3.8.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "autocannon": "8.0.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
