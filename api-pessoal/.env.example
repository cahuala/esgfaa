# Sistema de Gestão de Pessoal (servidor interno da Escola) — copie para .env e preencha.
# Este sistema NÃO vai para a internet: só responde às redes internas abaixo.

NODE_ENV=production
PORT=3002
# IP da placa de rede interna do servidor (não use 0.0.0.0 se o servidor tiver ligação directa à internet)
HOST=10.10.0.5
# redes de onde se aceitam pedidos (IPv4/CIDR, separadas por vírgulas)
REDES_INTERNAS=10.10.0.0/16
# se estiver atrás de um proxy interno (Nginx), o número de proxies; senão deixe vazio
TRUST_PROXY=

# base de dados própria (não é a do portal)
DATABASE_URL=postgresql://pessoal:SENHA_FORTE@localhost:5432/esgfaa_pessoal
# 32+ caracteres aleatórios: openssl rand -base64 48
JWT_SECRET=
# chave da encriptação dos dados pessoais na base de dados (BI, filiação, telefone, morada) — obrigatória em
# produção. Gere com:  openssl rand -hex 32
# Guarde uma cópia num cofre fora do servidor: sem ela os dados cifrados NÃO se recuperam (nem das cópias de segurança).
DADOS_CHAVE=
# papéis que têm de usar a verificação em dois passos (em produção, por omissão, todos os que vêem fichas)
# DOIS_FATORES_PAPEIS=administrador,chefe,operador,consulta
SESSION_TTL=8h

# primeiro arranque: administrador do sistema de pessoal (depois pode tirar a palavra-passe daqui)
ADMIN_NOME=Administrador do Pessoal
ADMIN_EMAIL=pessoal@esgfaa.gov.ao
ADMIN_PASSWORD=

# aplicação já construída (npm run build na raiz) servida pelo próprio servidor
APP_DIR=../dist-pessoal
DATA_DIR=dados

# Ligação ao Portal Académico (num só sentido: daqui para o portal, só docentes e estudantes)
# endereço da API do portal e a MESMA chave que está no INTEGRACAO_CHAVE da API do portal
PORTAL_API_URL=https://api.esgfaa.gov.ao
INTEGRACAO_CHAVE=

# Consulta do BI (API do Estado, a mesma do SIGP); a rede resolve api.gov.ao por DNS-over-HTTPS se precisar
BI_API_URL=https://api.gov.ao/bi/v1/getBI
BI_API_KEY=
