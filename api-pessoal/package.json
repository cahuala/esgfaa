{
  "name": "esgfaa-api-pessoal",
  "version": "1.0.0",
  "private": true,
  "description": "API do Sistema de Gestão de Pessoal da Escola Superior de Guerra (só na rede interna)",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/servidor.js",
    "start": "prisma migrate deploy && node --env-file-if-exists=.env src/servidor.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "migrar": "prisma migrate deploy",
    "semear": "node --env-file-if-exists=.env scripts/semear.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
