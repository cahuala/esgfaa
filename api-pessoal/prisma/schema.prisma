// Sistema de Gestão de Pessoal da Escola Superior de Guerra — base de dados própria (rede interna).
// Militares dos três ramos e pessoal civil; carreiras segundo a Lei n.º 13/18.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// quem usa o sistema (Repartição de Pessoal e Quadros, chefia, consulta)
model Utilizador {
  id            Int            @id @default(autoincrement())
  nome          String
  email         String         @unique
  senha         String
  papel         String // administrador | chefe | comandante (vê tudo) | operador | consulta | utente (só expediente e mensagens)
  pessoaId      Int?           @unique @map("pessoa_id")
  unidadeId     Int?           @map("unidade_id")
  ativo         Boolean        @default(true)
  versaoToken   Int            @default(1) @map("versao_token")
  falhas        Int            @default(0)
  bloqueadoAte  DateTime?      @map("bloqueado_ate") @db.Timestamptz(3)
  ultimoAcesso  DateTime?      @map("ultimo_acesso") @db.Timestamptz(3)
  deveMudar     Boolean        @default(true) @map("deve_mudar")
  // quando tomou conhecimento do aviso de privacidade (Lei n.º 22/11)
  privacidadeEm DateTime?      @map("privacidade_em") @db.Timestamptz(3)
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa        Pessoa?        @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  unidade       Unidade?       @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  participacoes Participante[]
  mensagens     Mensagem[]
  doisFatores   DoisFatores?

  @@map("utilizadores")
}

// verificação em dois passos (TOTP); o segredo fica cifrado (DADOS_CHAVE)
model DoisFatores {
  id             Int        @id @default(autoincrement())
  utilizadorId   Int        @unique @map("utilizador_id")
  segredo        String
  ativo          Boolean    @default(false)
  ultimoContador Int        @default(-1) @map("ultimo_contador")
  recuperacao    Json       @default("[]")
  ativadoEm      DateTime?  @map("ativado_em") @db.Timestamptz(3)
  criadoEm       DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  utilizador     Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@map("dois_fatores")
}

// órgãos e serviços da Escola (Direcção, departamentos, repartições…)
model Unidade {
  id           Int          @id @default(autoincrement())
  nome         String
  sigla        String       @default("")
  // como no SIGP (U/E/O): comando | direccao | gabinete | departamento | reparticao | seccao | servico | batalhao | companhia | pelotao | curso | outro
  tipo         String       @default("outro")
  paiId        Int?         @map("pai_id")
  ordem        Int          @default(0)
  pai          Unidade?     @relation("Arvore", fields: [paiId], references: [id], onDelete: SetNull)
  filhos       Unidade[]    @relation("Arvore")
  cargos       Cargo[]
  pessoas      Pessoa[]
  utilizadores Utilizador[]
  conversas    Conversa[]

  @@map("unidades")
}

// cargos do quadro orgânico (art. 18.º): o posto que lhes corresponde e quantos lugares têm
model Cargo {
  id             Int      @id @default(autoincrement())
  nome           String
  unidadeId      Int?     @map("unidade_id")
  funcao         String   @default("execucao") // comando | direccao_chefia | estado_maior | execucao (art. 21.º)
  tipo           String   @default("militar") // militar | civil | ambos
  postoRequerido String?  @map("posto_requerido")
  categoriaCivil String?  @map("categoria_civil")
  vagas          Int      @default(1)
  unidade        Unidade? @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  pessoas        Pessoa[]

  @@map("cargos")
}

// a ficha de cada militar ou civil que serve na Escola (e dos estudantes dos cursos)
model Pessoa {
  id                   Int       @id @default(autoincrement())
  tipo                 String // militar | civil
  vinculo              String    @default("funcionario") // docente | estudante | funcionario | domiciliar
  // na Escola pode ter mais de uma função: o militar funcionário que também é professor, ou também é aluno
  outrosVinculos       String[]  @default([]) @map("outros_vinculos")
  // empregada(o) domiciliar: o oficial superior ou general a quem está afecta (não conta como trabalhador civil)
  militarAlocadoId     Int?      @map("militar_alocado_id")
  nome                 String
  nomeGuerra           String    @default("") @map("nome_guerra")
  nip                  String?   @unique
  numeroAgente         String?   @unique @map("numero_agente")
  bi                   String? // cifrado (AES-256-GCM)
  biIndice             String?   @unique @map("bi_indice") // HMAC do BI: único e para procurar sem decifrar
  dataNascimento       DateTime? @map("data_nascimento") @db.Date
  genero               String? // M | F
  estadoCivil          String?   @map("estado_civil")
  naturalidade         String    @default("")
  provincia            String    @default("")
  nacionalidade        String    @default("Angolana")
  pai                  String    @default("") // cifrado
  mae                  String    @default("") // cifrado
  email                String?   @unique
  telefone             String    @default("") // cifrado
  morada               String    @default("") // cifrado
  // morada em partes (ficha individual): município, bairro, rua, casa n.º, caixa postal
  municipio            String    @default("")
  bairro               String    @default("") // cifrado
  rua                  String    @default("") // cifrado
  casa                 String    @default("") // cifrado
  caixaPostal          String    @default("") @map("caixa_postal")
  telefoneAlternativo  String    @default("") @map("telefone_alternativo") // cifrado
  // bilhete de identidade: emissão e validade
  biEmitidoEm          DateTime? @map("bi_emitido_em") @db.Date
  biValidade           DateTime? @map("bi_validade") @db.Date
  biLocalEmissao       String    @default("") @map("bi_local_emissao")
  grupoSanguineo       String    @default("") @map("grupo_sanguineo")
  // agregado familiar: cônjuge e [{ nome, parentesco, dataNascimento, nacionalidade, profissao }] (JSON cifrado)
  conjuge              String    @default("") // cifrado
  conjugeLocalServico  String    @default("") @map("conjuge_local_servico")
  agregado             String    @default("") // cifrado (JSON)
  /**
   * registo biográfico (ficha de registo biográfico dos civis, também para os militares): estudos, línguas,
   * últimos locais de trabalho, colocações, situação militar, situação médica, classificação de serviço,
   * assiduidade e outras informações. JSON cifrado.
   */
  registo              String    @default("") // cifrado (JSON)
  // vencimento mensal em kwanzas (para as declarações) e n.º de segurança social
  vencimento           String    @default("") // cifrado
  inss                 String    @default("")
  // dados bancários (para a folha de vencimentos): IBAN e conta cifrados
  banco                String    @default("")
  iban                 String    @default("") // cifrado
  numeroConta          String    @default("") @map("numero_conta") // cifrado
  // incorporação (ficha individual do militar)
  localIncorporacao    String    @default("") @map("local_incorporacao")
  voluntario           Boolean?
  // docentes (ficha de cadastramento dos docentes): efectivo ou colaborador e a categoria
  tipoDocente          String?   @map("tipo_docente")
  categoriaDocente     String    @default("") @map("categoria_docente")
  // docente colaborador (militar ou civil de fora da Escola): a função ou o cargo que tem lá fora
  funcaoActual         String    @default("") @map("funcao_actual")
  paisNascimento       String    @default("Angola") @map("pais_nascimento")
  habilitacao          String? // base | medio | bacharelato | licenciatura | mestrado | doutoramento
  areaFormacao         String    @default("") @map("area_formacao")
  fotoId               String?   @map("foto_id")
  unidadeId            Int?      @map("unidade_id")
  cargoId              Int?      @map("cargo_id")
  dataCargo            DateTime? @map("data_cargo") @db.Date
  // militar (Lei n.º 13/18)
  ramo                 String? // EXE | FAN | MGA
  posto                String?
  fps                  String? // QP | SMC | SMO | SMR
  quadroEspecial       String?   @map("quadro_especial")
  especialidade        String    @default("")
  situacao             String?   @default("activo") // activo | reserva | reforma
  efectividade         String?   @default("comissao_normal")
  estado               String? // estado operacional: destacado | em_missao | em_formacao | … (sem estado = ao serviço)
  dataIngresso         DateTime? @map("data_ingresso") @db.Date
  dataIngressoQP       DateTime? @map("data_ingresso_qp") @db.Date
  dataAntiguidadePosto DateTime? @map("data_antiguidade_posto") @db.Date
  dataSituacao         DateTime? @map("data_situacao") @db.Date
  avaliacaoFavoravel   Boolean   @default(true) @map("avaliacao_favoravel")
  aptidaoFisica        Boolean   @default(true) @map("aptidao_fisica")
  processoPendente     Boolean   @default(false) @map("processo_pendente")
  // civil
  carreiraCivil        String?   @map("carreira_civil")
  categoriaCivil       String?   @map("categoria_civil")
  vinculoCivil         String?   @map("vinculo_civil") // nomeacao_definitiva | nomeacao_provisoria | contrato
  dataAdmissao         DateTime? @map("data_admissao") @db.Date
  dataCategoria        DateTime? @map("data_categoria") @db.Date
  ativo                Boolean   @default(true) // continua na Escola
  // histórico dos efectivos da Escola: quando entrou e, se já saiu, quando, porquê e para onde
  dataEntradaEscola    DateTime? @map("data_entrada_escola") @db.Date
  dataSaidaEscola      DateTime? @map("data_saida_escola") @db.Date
  motivoSaida          String    @default("") @map("motivo_saida")
  destinoSaida         String    @default("") @map("destino_saida")
  observacoes          String    @default("")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime  @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  unidade            Unidade?           @relation(fields: [unidadeId], references: [id], onDelete: SetNull)
  cargo              Cargo?             @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  cursos             Curso[]
  eventos            Evento[]
  graduacoes         Graduacao[]
  licencas           Licenca[]
  ausencias          Ausencia[]
  planoFerias        PlanoFerias[]
  documentosEmitidos DocumentoEmitido[]
  itens              ItemProposta[]
  sincronizacao      Sincronizacao?
  militarAlocado     Pessoa?            @relation("Domiciliares", fields: [militarAlocadoId], references: [id], onDelete: SetNull)
  domiciliares       Pessoa[]           @relation("Domiciliares")
  processo           Processo?
  documentos         DocumentoPessoal[]
  itensExtracto      ItemExtracto[]
  utilizador         Utilizador?
  pedidosDados       PedidoDados[]

  @@index([tipo, ativo])
  @@map("pessoas")
}

// cursos do militar (art. 48.º), incluindo os que são condição de promoção (art. 52.º)
model Curso {
  id             Int       @id @default(autoincrement())
  pessoaId       Int       @map("pessoa_id")
  chave          String? // curso de promoção previsto na lei (ex.: promocao_capitao)
  nome           String
  tipo           String    @default("formacao") // formacao | promocao | qualificacao | actualizacao | academico
  local          String    @default("")
  inicio         DateTime? @db.Date
  fim            DateTime? @db.Date
  aproveitamento Boolean?
  classificacao  Decimal?  @db.Decimal(5, 2)
  pessoa         Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@map("cursos")
}

// histórico da carreira: promoções, graduações, nomeações, exonerações, mudanças de situação…
model Evento {
  id            Int      @id @default(autoincrement())
  pessoaId      Int      @map("pessoa_id")
  tipo          String
  data          DateTime @db.Date
  postoAnterior String?  @map("posto_anterior")
  postoNovo     String?  @map("posto_novo")
  cargoNome     String   @default("") @map("cargo_nome")
  descricao     String   @default("")
  documento     String   @default("") // n.º da ordem, despacho…
  entidade      String   @default("")
  pena          String   @default("") // punição ou condenação: a pena aplicada
  propostaId    Int?     @map("proposta_id")
  criadoPor     String   @default("") @map("criado_por")
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa        Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId, data])
  @@map("eventos")
}

// graduações (arts. 64.º a 67.º)
model Graduacao {
  id         Int       @id @default(autoincrement())
  pessoaId   Int       @map("pessoa_id")
  posto      String
  motivo     String    @default("")
  inicio     DateTime  @db.Date
  fim        DateTime? @db.Date
  ativa      Boolean   @default(true)
  propostaId Int?      @map("proposta_id")
  pessoa     Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@map("graduacoes")
}

// licenças (arts. 31.º a 41.º)
// faltas e ausências que não são licenças (Mapa de ausências temporárias): falta justificada, ausência sem
// justificação, baixa hospitalar e detenção; com o fim em aberto enquanto durar (hospital, detido)
model Ausencia {
  id        Int       @id @default(autoincrement())
  pessoaId  Int       @map("pessoa_id")
  tipo      String // falta | sem_justificacao | hospital | detido
  inicio    DateTime  @db.Date
  fim       DateTime? @db.Date
  motivo    String    @default("")
  documento String    @default("") // participação, guia de baixa, auto…
  criadoPor String    @default("") @map("criado_por")
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa    Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId, inicio])
  @@map("ausencias")
}

model Licenca {
  id          Int      @id @default(autoincrement())
  pessoaId    Int      @map("pessoa_id")
  tipo        String
  inicio      DateTime @db.Date
  fim         DateTime @db.Date
  dias        Int
  despacho    String   @default("")
  observacoes String   @default("")
  criadoPor   String   @default("") @map("criado_por")
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa      Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@index([pessoaId, inicio])
  @@map("licencas")
}

// plano de férias (como no SIGP): o mês de férias de cada pessoa em cada ano; as guias de férias saem dele
model PlanoFerias {
  id        Int      @id @default(autoincrement())
  ano       Int
  pessoaId  Int      @map("pessoa_id")
  mes       Int // 1 a 12
  criadoPor String   @default("") @map("criado_por")
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa    Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([ano, pessoaId])
  @@map("plano_ferias")
}

// propostas de promoção, nomeação, graduação e exoneração (militares) e de progressão e nomeação (civis)
model Proposta {
  id            Int             @id @default(autoincrement())
  tipo          String
  estado        String          @default("rascunho") // rascunho | submetida | aprovada | rejeitada | cancelada
  titulo        String
  fundamentacao String          @default("")
  curso         String          @default("") // nas propostas para curso: o curso ou acção de formação
  criadoPor     String          @map("criado_por")
  submetidaEm   DateTime?       @map("submetida_em") @db.Timestamptz(3)
  decididoPor   String          @default("") @map("decidido_por")
  decididaEm    DateTime?       @map("decidida_em") @db.Timestamptz(3)
  documento     String          @default("")
  dataDocumento DateTime?       @map("data_documento") @db.Date
  entidade      String          @default("")
  motivo        String          @default("") // do indeferimento ou do cancelamento
  extractoId    Int?            @map("extracto_id")
  criadoEm      DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)
  itens         ItemProposta[]
  anexos        AnexoProposta[]

  @@index([estado])
  @@map("propostas")
}

// documentos digitalizados da proposta: ofício de envio, resposta do escalão superior, despachos…
model AnexoProposta {
  id           Int      @id @default(autoincrement())
  propostaId   Int      @map("proposta_id")
  titulo       String
  ficheiro     String
  nomeOriginal String   @map("nome_original")
  mime         String
  tamanho      Int
  criadoPor    String   @map("criado_por")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  proposta     Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@index([propostaId])
  @@map("anexos_proposta")
}

model ItemProposta {
  id                Int       @id @default(autoincrement())
  propostaId        Int       @map("proposta_id")
  pessoaId          Int       @map("pessoa_id")
  postoAtual        String?   @map("posto_atual")
  postoProposto     String?   @map("posto_proposto")
  modalidade        String?
  cargoId           Int?      @map("cargo_id")
  categoriaAtual    String?   @map("categoria_atual")
  categoriaProposta String?   @map("categoria_proposta")
  inicio            DateTime? @db.Date
  fim               DateTime? @db.Date
  verificacao       Json      @default("{}") // resultado das regras da lei quando a proposta foi feita
  justificacao      String    @default("")
  proposta          Proposta  @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  pessoa            Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([propostaId, pessoaId])
  @@map("itens_proposta")
}

// quem fez o quê (consultas e alterações)
model Auditoria {
  id         Int      @id @default(autoincrement())
  quando     DateTime @default(now()) @db.Timestamptz(3)
  utilizador String
  acao       String
  alvo       String   @default("")
  detalhes   Json     @default("{}")
  ip         String   @default("")

  @@index([quando])
  @@map("auditoria")
}

// envio dos docentes e estudantes para as contas do Portal Académico (num só sentido: daqui para lá)
model Sincronizacao {
  pessoaId        Int       @id @map("pessoa_id")
  estado          String    @default("pendente") // pendente | enviado | erro
  tentativas      Int       @default(0)
  ultimaTentativa DateTime? @map("ultima_tentativa") @db.Timestamptz(3)
  erro            String    @default("")
  contaPortalId   Int?      @map("conta_portal_id")
  // a fotografia que o portal já tem (só se envia outra vez quando muda)
  fotoEnviada     String    @default("") @map("foto_enviada")
  pessoa          Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@map("sincronizacao")
}

// processo individual (arquivo físico): número, onde está a pasta e em que estado
model Processo {
  pessoaId     Int      @id @map("pessoa_id")
  numero       String   @unique // PI-00001
  estante      String   @default("")
  prateleira   String   @default("")
  posicao      String   @default("")
  estado       String   @default("activo") // activo | encapado | em_falta | arquivado
  observacoes  String   @default("")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  pessoa       Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@map("processos")
}

// documentos digitalizados do processo individual (extractos, BI, certificados, sínteses…)
model DocumentoPessoal {
  id           Int       @id @default(autoincrement())
  pessoaId     Int       @map("pessoa_id")
  tipo         String
  titulo       String
  ficheiro     String
  nomeOriginal String    @map("nome_original")
  mime         String
  tamanho      Int
  data         DateTime? @db.Date
  extractoId   Int?      @map("extracto_id")
  criadoPor    String    @map("criado_por")
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa       Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  extracto     Extracto? @relation(fields: [extractoId], references: [id], onDelete: SetNull)

  @@index([pessoaId])
  @@map("documentos_pessoais")
}

// extracto de ordem (promoção, nomeação, reforma…) que chega do escalão superior
model Extracto {
  id           Int                @id @default(autoincrement())
  tipo         String // promocao | nomeacao | graduacao | exoneracao | reserva | reforma | outro
  numero       String
  data         DateTime           @db.Date
  entidade     String             @default("")
  ficheiro     String             @default("")
  nomeOriginal String             @default("") @map("nome_original")
  texto        String             @default("")
  estado       String             @default("pendente") // pendente | aplicado
  propostaId   Int?               @map("proposta_id")
  criadoPor    String             @map("criado_por")
  criadoEm     DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)
  aplicadoEm   DateTime?          @map("aplicado_em") @db.Timestamptz(3)
  itens        ItemExtracto[]
  documentos   DocumentoPessoal[]

  @@map("extractos")
}

model ItemExtracto {
  id            Int      @id @default(autoincrement())
  extractoId    Int      @map("extracto_id")
  pessoaId      Int      @map("pessoa_id")
  postoNovo     String?  @map("posto_novo")
  cargoId       Int?     @map("cargo_id")
  encontradoPor String   @default("manual") @map("encontrado_por") // nip | nome | proposta | manual
  aplicado      Boolean  @default(false)
  extracto      Extracto @relation(fields: [extractoId], references: [id], onDelete: Cascade)
  pessoa        Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([extractoId, pessoaId])
  @@map("itens_extracto")
}

// expediente: documentos que circulam entre as áreas da Escola (e de/para fora), com o percurso do original físico
model Expediente {
  id              Int               @id @default(autoincrement())
  protocolo       String            @unique // EXP-2026-0001
  sentido         String            @default("interno") // interno | entrada | saida
  tipo            String            @default("oficio")
  numero          String            @default("") // n.º do documento original
  assunto         String
  resumo          String            @default("")
  classificacao   String            @default("normal") // normal | urgente | confidencial
  origemUnidadeId Int?              @map("origem_unidade_id")
  entidadeExterna String            @default("") @map("entidade_externa")
  temFisico       Boolean           @default(false) @map("tem_fisico")
  prazo           DateTime?         @db.Date
  estado          String            @default("em_curso") // em_curso | arquivado
  // onde fica o original em papel depois de arquivado: armário, prateleira e pasta (dossier)
  armario         String            @default("")
  prateleira      String            @default("")
  pasta           String            @default("")
  arquivadoEm     DateTime?         @map("arquivado_em") @db.Timestamptz(3)
  // Secretária digital: o documento submetido a despacho do Comandante e a decisão dele
  // { estado: pendente|despachado, nota, pedidoPor, pedidoUnidadeId, pedidoEm, decisao, texto, despachadoPor, despachadoEm }
  despacho        Json?
  criadoPorId     Int               @map("criado_por_id")
  criadoEm        DateTime          @default(now()) @map("criado_em") @db.Timestamptz(3)
  anexos          AnexoExpediente[]
  movimentos      Movimento[]

  @@index([criadoEm])
  @@map("expedientes")
}

model AnexoExpediente {
  id           Int        @id @default(autoincrement())
  expedienteId Int        @map("expediente_id")
  ficheiro     String
  nomeOriginal String     @map("nome_original")
  mime         String
  tamanho      Int
  criadoPorId  Int        @map("criado_por_id")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@map("anexos_expediente")
}

// cada passo do percurso: enviar, encaminhar, receber (e o original físico: entregue, recebido)
model Movimento {
  id               Int        @id @default(autoincrement())
  expedienteId     Int        @map("expediente_id")
  deUnidadeId      Int?       @map("de_unidade_id")
  paraUnidadeId    Int?       @map("para_unidade_id")
  nota             String     @default("")
  enviadoPorId     Int        @map("enviado_por_id")
  enviadoEm        DateTime   @default(now()) @map("enviado_em") @db.Timestamptz(3)
  recebidoPorId    Int?       @map("recebido_por_id")
  recebidoEm       DateTime?  @map("recebido_em") @db.Timestamptz(3)
  fisico           String     @default("nao_aplica") // nao_aplica | a_enviar | entregue | recebido
  fisicoPortador   String     @default("") @map("fisico_portador")
  fisicoRecebidoEm DateTime?  @map("fisico_recebido_em") @db.Timestamptz(3)
  expediente       Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([paraUnidadeId, recebidoEm])
  @@map("movimentos")
}

// mensagens internas: conversas directas, de grupo, de cada unidade e a geral da Escola
model Conversa {
  id            Int            @id @default(autoincrement())
  tipo          String // directa | grupo | unidade | geral
  nome          String         @default("")
  unidadeId     Int?           @unique @map("unidade_id")
  chave         String?        @unique // conversa directa: "menorId-maiorId"
  criadoEm      DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  ultimaEm      DateTime       @default(now()) @map("ultima_em") @db.Timestamptz(3)
  unidade       Unidade?       @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  participantes Participante[]
  mensagens     Mensagem[]

  @@map("conversas")
}

model Participante {
  conversaId   Int        @map("conversa_id")
  utilizadorId Int        @map("utilizador_id")
  lidoAte      DateTime   @default(now()) @map("lido_ate") @db.Timestamptz(3)
  conversa     Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@id([conversaId, utilizadorId])
  @@map("participantes")
}

model Mensagem {
  id           Int        @id @default(autoincrement())
  conversaId   Int        @map("conversa_id")
  autorId      Int        @map("autor_id")
  texto        String
  ficheiro     String?
  nomeOriginal String?    @map("nome_original")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  conversa     Conversa   @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor        Utilizador @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversaId, id])
  @@map("mensagens")
}

// pedidos das pessoas sobre os seus dados (Lei n.º 22/11): rectificação, oposição, acesso…
model PedidoDados {
  id            Int       @id @default(autoincrement())
  pessoaId      Int       @map("pessoa_id")
  tipo          String
  texto         String
  estado        String    @default("pendente") // pendente | respondido | recusado
  resposta      String    @default("")
  respondidoPor String    @default("") @map("respondido_por")
  respondidoEm  DateTime? @map("respondido_em") @db.Timestamptz(3)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  pessoa        Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@map("pedidos_dados")
}

// documentos emitidos (declarações, guias…): a numeração de cada série por ano e o registo de quem emitiu
model DocumentoEmitido {
  id              Int       @id @default(autoincrement())
  pessoaId        Int       @map("pessoa_id")
  tipo            String // declaracao_efectividade | guia_ferias | ficha_individual | …
  serie           String    @default("") // série da numeração (declaracao); vazio = sem número
  ano             Int
  numero          Int?
  dados           Json      @default("{}") // as opções escolhidas (finalidade, dias, destino…)
  emitidoPor      String    @map("emitido_por")
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  // controlo das declarações (como no SIGP): quantas vezes se imprimiu e a última
  impressoes      Int       @default(0)
  ultimaImpressao DateTime? @map("ultima_impressao") @db.Timestamptz(3)
  pessoa          Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([serie, ano, numero])
  @@index([pessoaId])
  @@map("documentos_emitidos")
}

// definições do sistema (ex.: quem assina os documentos)
model Definicao {
  chave String @id
  valor Json

  @@map("definicoes")
}
